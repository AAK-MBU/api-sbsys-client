# .env.example
# Kopier til .env — .env er allerede i .gitignore og maa aldrig committes.
SBSYS_BASE_URL=https://sbsyswebapi.<miljoe>.dk
SBSYS_TOKEN_URL=https://<host>/auth/realms/sbsip/protocol/openid-connect/token
SBSYS_CLIENT_ID=
SBSYS_CLIENT_SECRET=
SBSYS_USERNAME=
SBSYS_PASSWORD=

# Valgfrit
SBSYS_TIMEOUT=30
SBSYS_MAX_RETRIES=3
# Sti til CA-bundle hvis miljoeet bruger et internt certifikat.
# SBSYS_VERIFY=/etc/ssl/certs/kommune-ca.pem
